  shorttitle = {Mysticeti},
  booktitle = {Proceedings 2025 {{Network}} and {{Distributed System Security Symposium}}},
  author = {Babel, Kushal and Chursin, Andrey and Danezis, George and Kichidis, Anastasios and Kokoris-Kogias, Lefteris and Koshy, Arun and Sonnino, Alberto and Tian, Mingwei},
