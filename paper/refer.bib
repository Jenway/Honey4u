@article{cheng_mathsf_2025,
	title = {{\textbackslash}mathsf {JUMBOJUMBO}: Fully Asynchronous {BFT} Consensus Made Truly Scalable},
	volume = {22},
	issn = {1941-0018},
	url = {https://ieeexplore.ieee.org/document/11002681},
	doi = {10.1109/TDSC.2025.3569608},
	shorttitle = {{\textbackslash}mathsf {JUMBOJUMBO}},
	abstract = {Recent progresses in asynchronous Byzantine fault-tolerant ({BFT}) consensus, e.g., {\textbackslash}mathsf Dumbo{\textbackslash}text -{\textbackslash}mathsf {NGDumbo}-{NG} ({CCS}’ 22) and {\textbackslash}mathsf {TuskTusk} ({EuroSys}’ 22), show promising performance through decoupling transaction dissemination and block agreement. However, when executed with a larger number nn of nodes, like several hundreds, they would suffer from significant degradation in performance. Their dominating scalability bottleneck is the huge authenticator complexity: each node has to multicast {\textbackslash}mathcal O(n)O(n) quorum certificates ({QCs}) and subsequently verify them for each block. This paper systematically investigates and resolves the above scalability issue. We first propose a signature-free asynchronous {BFT} consensus {\textbackslash}mathsf {FIN}{\textbackslash}text -{\textbackslash}mathsf {NGFIN}-{NG} that adapts a recent signature-free asynchronous common subset protocol {FIN} ({CCS}’ 23) into the state-of-the-art framework of concurrent broadcast and agreement. The liveness of {\textbackslash}mathsf {FIN}{\textbackslash}text -{\textbackslash}mathsf {NGFIN}-{NG} relies on our non-trivial redesign of {FIN}’s multi-valued validated Byzantine agreement towards achieving optimal quality. {\textbackslash}mathsf {FIN}{\textbackslash}text -{\textbackslash}mathsf {NGFIN}-{NG} greatly improves the performance of {FIN} and already outperforms {\textbackslash}mathsf Dumbo{\textbackslash}text -{\textbackslash}mathsf {NGDumbo}-{NG} in most deployment settings. To further overcome the scalability limit of {\textbackslash}mathsf {FIN}{\textbackslash}text -{\textbackslash}mathsf {NGFIN}-{NG} due to {\textbackslash}mathcal O(n{\textasciicircum}3)O(n3) messages, we propose {\textbackslash}mathsf {JUMBOJUMBO}, a scalable instantiation of {\textbackslash}mathsf Dumbo{\textbackslash}text -{\textbackslash}mathsf {NGDumbo}-{NG}, with only {\textbackslash}mathcal O(n{\textasciicircum}2)O(n2) complexities for both authenticators and messages. We use various aggregation and dispersal techniques for {QCs} to significantly reduce the authenticator complexity of original {\textbackslash}mathsf Dumbo{\textbackslash}text -{\textbackslash}mathsf {NGDumbo}-{NG} implementations by up to {\textbackslash}mathcal O(n{\textasciicircum}2)O(n2) orders. Finally, we implement our designs in Golang and experimentally demonstrated their enhanced scalability with hundreds of Amazon’s {AWS} instances. {\textbackslash}mathsf {JUMBOJUMBO} and {FIN}-{NG} significantly outperform the state-of-the-art in (nearly) all deployment settings. Especially, when n{\textbackslash}gen≥196, {\textbackslash}mathsf {JUMBOJUMBO} can attain a throughput that is more than 4× that of {FIN} and {\textbackslash}mathsf Dumbo{\textbackslash}text -{\textbackslash}mathsf {NGDumbo}-{NG}.},
	pages = {5584--5602},
	number = {5},
	journaltitle = {{IEEE} Transactions on Dependable and Secure Computing},
	author = {Cheng, Hao and Lu, Yuan and Lu, Zhenliang and Tang, Qiang and Zhang, Yuxuan and Zhang, Zhenfeng},
	urldate = {2026-03-09},
	date = {2025-09},
	keywords = {Blockchain consensus, asynchronous byzantine agreement, Bandwidth, byzantine fault tolerance, Censorship, Complexity theory, Consensus protocol, Costs, Electronic mail, Local area networks, Scalability, Software, Throughput},
	file = {PDF:C\:\\Users\\jenway\\Zotero\\storage\\ZWXGX2W9\\Cheng 等 - 2025 - mathsf JUMBOJUMBO Fully Asynchronous BFT Consensus Made Truly Scalable.pdf:application/pdf},
}

@inproceedings{babel_mysticeti_2025,
	location = {San Diego, {CA}, {USA}},
	title = {Mysticeti: Reaching the Latency Limits with Uncertified {DAGs}},
	isbn = {979-8-9894372-8-3},
	url = {https://www.ndss-symposium.org/wp-content/uploads/2025-929-paper.pdf},
	doi = {10.14722/ndss.2025.240929},
	shorttitle = {Mysticeti},
	abstract = {We introduce Mysticeti-C, the first {DAG}-based Byzantine consensus protocol to achieve the lower bounds of latency of 3 message rounds. Since Mysticeti-C is built over {DAGs} it also achieves high resource efficiency and censorship resistance. Mysticeti-C achieves this latency improvement by avoiding explicit certification of the {DAG} blocks and by proposing a novel commit rule such that every block can be committed without delays, resulting in optimal latency in the steady state and under crash failures. We further extend Mysticeti-C to Mysticeti-{FPC}, which incorporates a fast commit path that achieves even lower latency for transferring assets. Unlike prior fast commit path protocols, {MysticetiFPC} minimizes the number of signatures and messages by weaving the fast path transactions into the {DAG}. This frees up resources, which subsequently result in better performance. We prove the safety and liveness in a Byzantine context. We evaluate both Mysticeti protocols and compare them with state-of-the-art consensus and fast path protocols to demonstrate their low latency and resource efficiency, as well as their more graceful degradation under crash failures. Mysticeti-C is the first Byzantine consensus protocol to achieve {WAN} latency of 0.5s for consensus commit while simultaneously maintaining state-of-the-art throughput of over 200k {TPS}. Finally, we report on integrating {MysticetiC} as the consensus protocol into the Sui blockchain [1], resulting in over 4x latency reduction.},
	eventtitle = {Network and Distributed System Security Symposium},
	booktitle = {Proceedings 2025 Network and Distributed System Security Symposium},
	publisher = {Internet Society},
	author = {Babel, Kushal and Chursin, Andrey and Danezis, George and Kichidis, Anastasios and Kokoris-Kogias, Lefteris and Koshy, Arun and Sonnino, Alberto and Tian, Mingwei},
	urldate = {2026-03-09},
	date = {2025},
	langid = {english},
	file = {PDF:C\:\\Users\\jenway\\Zotero\\storage\\SS6CCNRT\\Babel 等 - 2025 - Mysticeti Reaching the Latency Limits with Uncertified DAGs.pdf:application/pdf},
}

@inproceedings{zhang_pace_2022,
	location = {New York, {NY}, {USA}},
	title = {{PACE}: Fully Parallelizable {BFT} from Reproposable Byzantine Agreement},
	isbn = {978-1-4503-9450-5},
	url = {https://dl.acm.org/doi/10.1145/3548606.3559348},
	doi = {10.1145/3548606.3559348},
	series = {{CCS} '22},
	shorttitle = {{PACE}},
	abstract = {The classic asynchronous Byzantine fault tolerance ({BFT}) framework of Ben-Or, Kemler, and Rabin ({BKR}) and its descendants rely on reliable broadcast ({RBC}) and asynchronous binary agreement ({ABA}). However, {BKR} does not allow all {ABA} instances to run in parallel, a well-known performance bottleneck. We propose {PACE}, a generic framework that removes the bottleneck, allowing fully parallelizable {ABA} instances. {PACE} is built on {RBC} and reproposable {ABA} ({RABA}). Different from the conventional {ABA}, {RABA} allows a replica to change its mind and vote twice. We show how to efficiently build {RABA} protocols from existing {ABA} protocols and a new {ABA} protocol that we introduce.We implement six new {BFT} protocols: three in the {BKR} framework, and three in the {PACE} framework. Via a deployment using 91 replicas on Amazon {EC}2 across five continents, we show that all {PACE} instantiations, in both failure-free and failure scenarios, significantly outperform their {BKR} counterparts, and prior {BFT} protocols such as {BEAT} and Dumbo, in terms of latency, throughput, latency vs. throughput, and scalability.},
	pages = {3151--3164},
	booktitle = {Proceedings of the 2022 {ACM} {SIGSAC} Conference on Computer and Communications Security},
	publisher = {Association for Computing Machinery},
	author = {Zhang, Haibin and Duan, Sisi},
	urldate = {2026-03-09},
	date = {2022-11-07},
	file = {Full Text PDF:C\:\\Users\\jenway\\Zotero\\storage\\M736GLY9\\Zhang和Duan - 2022 - PACE Fully Parallelizable BFT from Reproposable Byzantine Agreement.pdf:application/pdf},
}

@inproceedings{danezis_narwhal_2022,
	location = {New York, {NY}, {USA}},
	title = {Narwhal and Tusk: a {DAG}-based mempool and efficient {BFT} consensus},
	isbn = {978-1-4503-9162-7},
	url = {https://dl.acm.org/doi/10.1145/3492321.3519594},
	doi = {10.1145/3492321.3519594},
	series = {{EuroSys} '22},
	shorttitle = {Narwhal and Tusk},
	abstract = {We propose separating the task of reliable transaction dissemination from transaction ordering, to enable high-performance Byzantine fault-tolerant quorum-based consensus. We design and evaluate a mempool protocol, Narwhal, specializing in high-throughput reliable dissemination and storage of causal histories of transactions. Narwhal tolerates an asynchronous network and maintains high performance despite failures. Narwhal is designed to easily scale-out using multiple workers at each validator, and we demonstrate that there is no foreseeable limit to the throughput we can achieve.Composing Narwhal with a partially synchronous consensus protocol (Narwhal-{HotStuff}) yields significantly better throughput even in the presence of faults or intermittent loss of liveness due to asynchrony. However, loss of liveness can result in higher latency. To achieve overall good performance when faults occur we design Tusk, a zero-message overhead asynchronous consensus protocol, to work with Narwhal. We demonstrate its high performance under a variety of configurations and faults.As a summary of results, on a {WAN}, Narwhal-Hotstuff achieves over 130,000 tx/sec at less than 2-sec latency compared with 1,800 tx/sec at 1-sec latency for Hotstuff. Additional workers increase throughput linearly to 600,000 tx/sec without any latency increase. Tusk achieves 160,000 tx/sec with about 3 seconds latency. Under faults, both protocols maintain high throughput, but Narwhal-{HotStuff} suffers from increased latency.},
	pages = {34--50},
	booktitle = {Proceedings of the Seventeenth European Conference on Computer Systems},
	publisher = {Association for Computing Machinery},
	author = {Danezis, George and Kokoris-Kogias, Lefteris and Sonnino, Alberto and Spiegelman, Alexander},
	urldate = {2026-03-09},
	date = {2022-03-28},
	file = {Full Text PDF:C\:\\Users\\jenway\\Zotero\\storage\\XWZUQXTN\\Danezis 等 - 2022 - Narwhal and Tusk a DAG-based mempool and efficient BFT consensus.pdf:application/pdf},
}

