@inproceedings{gaoDumboNGFastAsynchronous2022,
  title = {Dumbo-{{NG}}: Fast Asynchronous {{BFT}} Consensus with Throughput-Oblivious Latency},
  shorttitle = {Dumbo-{{NG}}},
  booktitle = {Proceedings of the 2022 {{ACM SIGSAC Conference}} on {{Computer}} and {{Communications Security}}},
  author = {Gao, Yingzi and Lu, Yuan and Lu, Zhenliang and Tang, Qiang and Xu, Jing and Zhang, Zhenfeng},
  date = {2022-11-07},
